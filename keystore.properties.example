# Modelo. Copia para `keystore.properties` (que está no .gitignore) e preenche.
# NUNCA commitar o ficheiro real nem as passwords.
#
# Alternativa sem ficheiro em disco — variáveis de ambiente com o mesmo efeito:
#   POL_STORE_FILE, POL_STORE_PASSWORD, POL_KEY_ALIAS, POL_KEY_PASSWORD
#
# `storeFile` é relativo à raiz do projeto.

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
