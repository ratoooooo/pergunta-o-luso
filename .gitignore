logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# Android / Gradle
*.iml
.gradle/
build/
/captures
captures/
.externalNativeBuild
.cxx
local.properties
.kotlin/
.navigation/
gen/
out/
release/

# Android Studio / IntelliJ
# Ignored wholesale except the few files that are genuinely worth sharing.
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/runConfigurations/
*.hprof

# Signing / secrets — never commit
keystore.properties
*.jks
*.keystore

# Firebase config: contains this project's API key + app id.
# Each developer generates their own from their own Firebase project (see README).
app/google-services.json
google-services.json
*/src/*/google-services.json

# Chave de conta de serviço do Firebase Admin (qa/apagar-contas-teste.js,
# qa/perguntas-admin.js). É uma credencial de ADMIN: ignora as security rules por completo.
# `*firebase-adminsdk*.json` é o nome que a consola gera; os outros dois são para quem lhe
# chamar outra coisa. Nenhum destes padrões apanha `google-services.json` (esse é config de
# cliente, e já está ignorado acima).
*firebase-adminsdk*.json
service-account*.json
qa/*.key.json
# A chave do servidor da partida é OUTRA, dedicada, e vive no VPS (/etc), não aqui. O padrão
# fica na mesma para o caso de alguém a trazer para a máquina de desenvolvimento.
servidor/*.key.json

# Build output
*.apk
*.aab
*.ap_
*.dex
*.class

# Vendor skill/agent reference docs (not project source)
.agents/
.claude/

# Lockfile de skills do tooling (não é código do projeto)
skills-lock.json

# macOS
.DS_Store

# Obsidian: configuração local do editor, não é conteúdo do vault
.obsidian/
docs/.obsidian/

# Páginas legais: main tem só o vault em docs/; as páginas HTML vivem em gh-pages
# (ver CLAUDE.md, "Files never committed"). Não misturar as duas árvores.
docs/index.html
docs/privacidade.html
docs/eliminar-conta.html
