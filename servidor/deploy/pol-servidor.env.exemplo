# /etc/pol-servidor.env — dono root:pol-servidor, modo 640.
#
# Nesta fase só existe a porta: o servidor arranca em MODO ESQUELETO, responde ao /saude, e
# recusa qualquer ligação de jogo com 401 (verificar um ID token exige o Firebase).
#
# As três variáveis do Firebase entram na fase em que a autenticação for ligada a sério. Só
# nessa altura se gera a chave de conta de serviço — é uma credencial poderosa e não se cria
# antes de fazer falta.

PORT=2567

# --- fase posterior, não preencher agora ---
# FIREBASE_PROJECT_ID=
# FIREBASE_DATABASE_URL=https://<projecto>-default-rtdb.europe-west1.firebasedatabase.app
# GOOGLE_APPLICATION_CREDENTIALS=/etc/pol-servidor.key.json
# ADMIN_TOKEN=
