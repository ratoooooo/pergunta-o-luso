{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    "categorias": {
      /* Fase 22: era `true`. Leitura pública deixava descarregar o banco inteiro de perguntas
         COM `respostaCorreta` sem sessão nenhuma, só com o URL da base de dados. Fechado a
         autenticados — anónimo conta, e todo o jogador passa pelo AuthGate antes de ver
         categorias. `CategoryRepository.loadCategories` faz REST direto e passou a enviar o
         ID token em `auth=`. */
      ".read": "auth != null",
      ".write": false
    },
    "perguntas_arquivadas": {
      /* Perguntas retiradas de `/categorias` pela manutenção do banco. Arquivar em vez de
         apagar: uma pergunta problemática (facto errado, enunciado ambíguo, duplicada) tem de
         poder ser revista — e reposta — depois, e as rules não têm lixeira nem histórico.

         Mesmo fecho de `categorias`, e pela mesma razão: o nó guarda `respostaCorreta`, por
         isso leitura pública deixava descarregar as respostas sem sessão nenhuma. `.write` a
         `false` não estorva a manutenção — a escrita de admin (service account em
         `qa/perguntas-admin.js`, ou `firebase database:set`) ignora as rules por completo. */
      ".read": "auth != null",
      ".write": false
    },
    "scores": {
      ".read": "auth != null",
      ".indexOn": "score",
      "$scoreId": {
        /* Pentest ago-2026: a regra anterior permitia ao dono ALTERAR campos de um registo
           existente (PATCH score, PUT com formato mudado). Confirmado ao vivo: score de 1x1
           alterado de 365 para 5999 por PATCH, e formato mudado de '1x1' para 'solo' por PUT.

           A regra agora permite exactamente três caminhos:
             1. `pol-servidor` — pode tudo (cria registos de todos os jogadores da partida).
             2. CRIAR um registo novo que traga o próprio uid (`!data.exists()`).
             3. APAGAR um registo que já é meu (`!newData.exists()`) — para eliminação de conta.
           ALTERAR (data.exists() && newData.exists()) por um jogador é BLOQUEADO.

           Os 12 registos legados sem `uid` continuam só de leitura: não são atribuíveis a
           nenhuma conta, por isso ninguém os consegue apagar — comportamento intencional. */
        ".write": "auth != null && (auth.uid === 'pol-servidor' || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'modo', 'categoria', 'score', 'correctCount', 'total', 'timestamp'])",
        "uid": { ".validate": "auth != null && (newData.val() === auth.uid || auth.uid === 'pol-servidor')" },
        "modo": { ".validate": "newData.isString()" },
        "categoria": { ".validate": "newData.isString()" },
        /* O travão de fundo desta fase: a pontuação de multijogador deixa de poder ser
           declarada pelo dispositivo. Um cliente só grava `solo` — que continua a ser decidido
           no cliente e sempre será, por não haver servidor de solo. Omitir o campo continua a
           passar (é a forma dos registos antigos, e o Histórico lê-os como solo); o que já não
           passa é um dispositivo afirmar que ganhou um 1x1. */
        "formato": { ".validate": "newData.isString() && (newData.val() === 'solo' || auth.uid === 'pol-servidor')" },
        "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000" },
        "correctCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "jogadores": {
      /* Fase 22: era `true`. Qualquer pessoa com o URL da RTDB despejava a tabela inteira de
         jogadores — nomes, stats, uids — sem sessão. Fechado a autenticados. Ranking e pesquisa
         de amigos continuam a funcionar: ninguém chega a esses ecrãs sem passar pelo AuthGate. */
      ".read": "auth != null",
      /* Player search (friends) does a prefix query on the lower-cased name. */
      ".indexOn": "nomeBusca",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nome']) || newData.hasChildren(['jogos'])",
        /* Fase 22: limite de comprimento. O nome é exibido publicamente no ranking e na
           pesquisa; sem isto passava um nome de 10 000 caracteres. Espelhado no cliente por
           `NOME_MAX_LEN` em ProfileRepository. */
        "nome": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "nomeBusca": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "atualizadoEm": { ".validate": "newData.isNumber()" },
        /* Pentest ago-2026: sem tectos, qualquer autenticado punha xpTotal em 999 999 999 999
           e aparecia no topo do ranking. Os tectos são generosos (cobrem anos de jogo intenso)
           mas bloqueiam valores impossíveis. `>= 0` impede negativos (confirmado: jogos=-9999
           passava antes desta correcção). */
        "jogos": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "pontos": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000" },
        "respostasCertas": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
        "respostasTotais": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
        "vitorias": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "recorde": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
        "maxStreak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "xpTotal": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
        "avatar": { ".validate": "newData.isString()" },
        "partidasPerfeitas": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },

        /* Fase 33 — sequência de DIAS seguidos a jogar. Não confundir com `maxStreak`, que é a
           melhor sequência de respostas certas dentro de uma partida.

           Os tectos são o mesmo tipo de chão de validação do resto do ficheiro: bloqueiam
           valores impossíveis, não implausíveis. A pontuação é validada no cliente (não há
           servidor), por isso 3660 dias — dez anos — é apenas o ponto a partir do qual o valor
           deixa de poder ser verdade. As datas são o dia civil de Lisboa em `AAAA-MM-DD`;
           guardar data e não timestamp é o que torna a comparação "ontem" possível sem fuso. */
        "diasSeguidos": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3660" },
        "maiorSequenciaDias": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3660" },
        "protecoesStreak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
        "ultimoDiaJogado": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "protecaoUsadaEm": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },

        "multiVitorias": {
          "$fmt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" }
        },
        "multiJogos": {
          "$fmt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" }
        },
        "categorias": {
          "$cat": {
            "jogos": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "vitorias": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "$other": { ".validate": false }
          }
        },
        "modos": {
          "$modo": {
            "jogos": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "pontos": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000" },
            "respostasCertas": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "respostasTotais": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "vitorias": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "recorde": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "amigos": {
      "$uid": {
        /* Only the owner ever reads their own friends + request queues. */
        ".read": "auth != null && auth.uid === $uid",
        "pedidosEnviados": {
          "$outro": {
            /* The owner manages their own sent requests. The other player may only DELETE it
               (when they accept or decline) — never create one on the owner's behalf. */
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $outro && !newData.exists()))",
            ".validate": "newData.hasChildren(['nome', 'ts'])",
            "nome": { ".validate": "newData.isString()" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "pedidosRecebidos": {
          "$outro": {
            /* Created (and withdrawn) by the SENDER, i.e. $outro; the owner may only delete it
               when accepting or declining. */
            ".write": "auth != null && (auth.uid === $outro || (auth.uid === $uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['nome', 'ts'])",
            "nome": { ".validate": "newData.isString()" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "lista": {
          "$outro": {
            /* The owner writes their own side. The other player may only write into this list
               while a request the owner SENT to them is still pending (that is the accept step),
               or to remove themselves — so nobody can add themselves as a friend unilaterally. */
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $outro && (!newData.exists() || root.child('amigos').child($uid).child('pedidosEnviados').child($outro).exists())))",
            ".validate": "newData.hasChildren(['nome', 'ts'])",
            "nome": { ".validate": "newData.isString()" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "convites": {
      "$uid": {
        /* Only the owner reads their own invites — nobody can see someone else's. */
        ".read": "auth != null && auth.uid === $uid",
        "enviados": {
          "$outro": {
            /* The challenger owns this entry. The invited player may only answer it (set
               `estado`) while the matching inbox entry still exists, or delete it.

               Pentest ago-2026: a regra anterior deixava $outro reescrever TODOS os campos
               (nome, salaId, formato…) desde que tivesse um `recebidos` pendente. Agora,
               quando $outro escreve com newData, os campos imutáveis têm de manter o valor
               que já está na base de dados — $outro só pode mudar `estado`. */
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $outro && (!newData.exists() || (root.child('convites').child($outro).child('recebidos').child($uid).exists() && newData.child('nome').val() === data.child('nome').val() && newData.child('formato').val() === data.child('formato').val() && newData.child('categoria').val() === data.child('categoria').val() && newData.child('modo').val() === data.child('modo').val() && newData.child('salaId').val() === data.child('salaId').val() && newData.child('ts').val() === data.child('ts').val()))))",
            ".validate": "newData.hasChildren(['nome', 'formato', 'categoria', 'modo', 'salaId', 'ts', 'estado'])",
            "nome": { ".validate": "newData.isString()" },
            "formato": { ".validate": "newData.isString()" },
            "categoria": { ".validate": "newData.isString()" },
            "modo": { ".validate": "newData.isString()" },
            "salaId": { ".validate": "newData.isString()" },
            "ts": { ".validate": "newData.isNumber()" },
            "estado": { ".validate": "newData.isString() && newData.val().matches(/^(pendente|aceite|recusado)$/)" },
            "$other": { ".validate": false }
          }
        },
        "recebidos": {
          "$outro": {
            /* Created (and withdrawn) by the CHALLENGER, i.e. $outro. The owner may only delete
               it — that is what accepting or declining does. */
            ".write": "auth != null && (auth.uid === $outro || (auth.uid === $uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['nome', 'formato', 'categoria', 'modo', 'salaId', 'ts', 'estado'])",
            "nome": { ".validate": "newData.isString()" },
            "formato": { ".validate": "newData.isString()" },
            "categoria": { ".validate": "newData.isString()" },
            "modo": { ".validate": "newData.isString()" },
            "salaId": { ".validate": "newData.isString()" },
            "ts": { ".validate": "newData.isNumber()" },
            "estado": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "presenca": {
      /* Online-presence counter for "A JOGAR AGORA". Every real reader is already authenticated
         (AuthGate runs before any screen that shows this), and there is no public/unauthenticated
         consumer (checked: no gh-pages widget, nothing outside the app reads this path) — so a
         fully public `.read: true` only gave away, to anyone on the internet with zero credentials,
         the live set of uids currently online. Pentest 2026-08-30: confirmed by an unauthenticated
         GET dumping a real online uid. Tightened to match every other node in this file. */
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isBoolean()"
      }
    },
    /* Fase 25: `/salas_privadas` não tinha regra nenhuma — o RTDB negava por omissão e criar
       sala privada por código falhava sempre, em produção. É uma tabela de consulta
       `codigo -> {lobbyId, format}`.

       Não há `.read` ao nível da colecção, só em `$codigo`: dá para consultar um código que se
       conheça, nunca para listar os códigos existentes. `!data.exists()` torna cada código
       create-once, para ninguém repontar um código já em uso para outra sala. E quem regista o
       código tem de ser o anfitrião real do lobby referido — o lobby é escrito antes, por isso
       `root` já o vê. */
    /* Fase 25: denúncias de quizzes da comunidade. Exigido pela Play Store por haver conteúdo
       gerado por utilizadores visível publicamente.

       Não há `.read` na colecção nem em `$quizId` — só cada pessoa lê a SUA denúncia, o que
       serve para a app saber se deve mostrar "Denunciar" ou "Já denunciaste". Ninguém consegue
       ver quem denunciou o quê. `!data.exists()` torna a denúncia irreversível e única por
       pessoa: não dá para denunciar duas vezes nem para retirar e repetir.

       A revisão é manual, na consola do Firebase (o SDK admin ignora estas regras). */
    "denuncias": {
      "$quizId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['motivo', 'ts'])",
          "motivo": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "categorias_comunitarias": {
      ".read": "auth != null",
      "$catId": {
        /* Só o dono cria ou reescreve o quiz inteiro (título, perguntas, etc). A condição
           antiga permitia a QUALQUER autenticado substituir o nó inteiro — incluindo
           título/perguntas/criadorUid de outra pessoa — desde que o payload tivesse uma
           chave "votos" lá dentro (`newData.child('votos').exists()` não estava restrita
           ao sub-caminho votos, avaliava para o nó completo). Um dono podia ser
           impersonado e o quiz de outro jogador reescrito por completo. Votar e atualizar
           a média/contagem passam a ter regras próprias e escritas nos caminhos exatos
           que tocam — não abrem mais a porta ao nó inteiro.
        */
        ".write": "auth != null && (!data.exists() || data.child('criadorUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['titulo', 'criadorUid', 'criadorNome', 'criadoEm'])",
        "id": { ".validate": "newData.isString()" },
        "titulo": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "descricao": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "criadorUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "criadorNome": { ".validate": "newData.isString()" },
        /* Fase 25: além do dono (que herda o `.write` do `$catId`), quem já denunciou este quiz
           pode despublicá-lo — e SÓ despublicar (`newData.val() === false`), nunca voltar a
           publicá-lo, e só depois de o contador ter atingido o limiar. Repor a público continua
           a ser exclusivo do autor. */
        "publica": {
          ".write": "auth != null && newData.val() === false && root.child('denuncias').child($catId).child(auth.uid).exists() && root.child('categorias_comunitarias').child($catId).child('totalDenuncias').val() >= 3",
          ".validate": "newData.isBoolean()"
        },
        /* Só incrementa quem tem uma denúncia registada, e só de um em um: sem o passo `+1` um
           único denunciante punha o contador em 999 e ocultava o quiz sozinho. Como as rules da
           RTDB não têm `numChildren()`, não é possível validar que o contador bate certo com o
           número real de denúncias — daí o incremento limitado. */
        "totalDenuncias": {
          ".write": "auth != null && root.child('denuncias').child($catId).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 1)"
        },
        "criadoEm": { ".validate": "newData.isNumber()" },
        "perguntas": {
          "$idx": {
            "pergunta": { ".validate": "newData.isString()" },
            "opcoes": { "$i": { ".validate": "newData.isString()" } },
            "respostaCorreta": { ".validate": "newData.isString()" },
            "dificuldade": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },
        /* Qualquer autenticado pode escrever o seu próprio voto e atualizar os agregados —
           mas só estes três campos exatos, nunca o resto do quiz (a regra do $catId acima
           continua a exigir dono para tudo o resto: um "set" à raiz com um payload
           fabricado já não encontra nenhuma regra que o autorize).
        */
        "votos": {
          /* Fase 22: escrita concedida também neste nó pai, para o `runTransaction` sobre
             `votos` em `CustomCategoryRepository.rateCategory` poder inserir o voto e ler o
             conjunto no mesmo commit. O dono-por-nó continua garantido pelo `.validate` do
             filho, que corre na mesma quando a escrita entra por aqui. */
          ".write": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && (auth.uid === $uid || data.exists())"
          }
        },
        /* Fase 22: era `.write: auth != null` — qualquer autenticado punha a média de qualquer
           quiz a 5.0 (ou a 0) sem sequer votar. Agora só escreve quem tem um voto seu
           registado neste quiz, e o valor tem de bater certo com a média/contagem dos votos
           reais. A app escreve os dois campos num `updateChildren` (multi-caminho), por isso
           são validados folha a folha e não exigem escrita no nó do quiz — que continua
           reservado ao dono. */
        "mediaClassificacao": {
          ".write": "auth != null && root.child('categorias_comunitarias').child($catId).child('votos').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "totalVotos": {
          ".write": "auth != null && root.child('categorias_comunitarias').child($catId).child('votos').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
